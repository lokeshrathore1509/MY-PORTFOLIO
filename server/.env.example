# ==========================================
# PORTFOLIO BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string, e.g. MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_db

# JWT Secret for Cookie Authentication (Change in production!)
JWT_SECRET=super_secure_portfolio_jwt_secret_lokesh_2026_xyz

# Initial Admin Credentials (Seeded on first startup or seed script)
ADMIN_EMAIL=admin@portfolio.dev
ADMIN_PASSWORD=Admin@2026!

# Cloudinary Storage Configuration (Optional: fallback stores images locally in /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
